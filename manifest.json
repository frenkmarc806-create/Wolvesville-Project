{
    "name": "BlenderDemon Script",
    "version": "1.0",
    "manifest_version": 3,
    "description": "Wolvesville Extension",
    "permissions": ["storage", "tabs", "activeTab"],
    "host_permissions": ["https://www.wolvesville.com/*"],
    "content_scripts": [
        {
            "matches": ["https://www.wolvesville.com/*"],
            "js": ["./scripts/contentScript.js"],
            "css": ["./styles/styles.css"]
        }
    ],
    "background": {
        "service_worker": "./scripts/background.js"
    },
    "icons": {
        "16": "assests/ww-16.png",
        "32": "assests/ww-32.png",
        "48": "assests/ww-48.png",
        "128": "assests/ww-128.png"
    },
    "action": {
        "default_title": "BlenderDemon Script",
        "default_popup": "popup.html"
    }
}